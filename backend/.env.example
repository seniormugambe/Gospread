DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DATABASE_URL=postgresql://user:password@host:5432/gospread
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# LiveKit — get these from https://cloud.livekit.io or your self-hosted LiveKit server
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Amazon IVS low-latency video broadcasts. Provide AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY in the backend environment, or attach an IAM role with
# ivs:CreateChannel, ivs:CreateStreamKey, ivs:StopStream, ivs:DeleteStreamKey,
# and cleanup permissions ivs:DeleteChannel.
AWS_IVS_REGION=us-east-1
